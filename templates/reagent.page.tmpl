<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>{{ .Name }} - Реагент</title>
    <link rel="stylesheet" href="/styles/order_style.css">
</head>
<body>
<header>
    <div class="title-container">
        <span class="calculator-title">Калькулятор синтеза метана (Реакция Сабатье)</span>
    </div>
    <div class="home-link">
        <a href="/reagents" class="calculate-btn" style="text-decoration: none;">Домой</a>
    </div>
</header>

<main class="order-main">
    <div class="wibes-card">
        <div class="wibes-header">
            <div class="wibes-avatar">
                <img src="{{ .Img }}" alt="{{ .Name }}">
            </div>
            <div class="wibes-title-info">
                <div class="wibes-name">{{ .Name }}</div>
                <div class="wibes-formula">{{ .Formula }}</div>
            </div>
        </div>

        <div class="wibes-video-wrapper">
            <video
                class="wibes-video"
                autoplay
                muted
                loop
                playsinline
                poster="{{ .Img }}"
            >
                <source src="{{ .Video }}" type="video/mp4">
            </video>

            <div class="wibes-actions">
                <div class="wibes-action-btn">
                    <span class="wibes-icon">❤️</span>
                    <span class="wibes-count">1.2K</span>
                </div>
                <div class="wibes-action-btn">
                    <span class="wibes-icon">💬</span>
                    <span class="wibes-count">45</span>
                </div>
                <div class="wibes-action-btn">
                    <span class="wibes-icon">🔖</span>
                    <span class="wibes-count">12</span>
                </div>
                <div class="wibes-action-btn">
                    <span class="wibes-icon">↗️</span>
                    <span class="wibes-count">Поделиться</span>
                </div>
            </div>

            <div class="wibes-video-info">
                <div class="wibes-desc">{{ .Description }}</div>
                <div class="wibes-stats">
                    <span>М: {{ .MolarMass }} г/моль</span>
                    <span>Чистота: {{ .Purity }}%</span>
                    <span>Цена: {{ .Price }} ₽</span>
                </div>
            </div>
        </div>

        <div class="wibes-product-bar">
            <div class="wibes-product-thumb">
                <img src="{{ .Img }}" alt="{{ .Name }}">
            </div>
            <div class="wibes-product-info">
                <div class="wibes-product-name">{{ .Name }}</div>
                <div class="wibes-product-price">{{ .Price }} ₽</div>
            </div>
            <form action="/add-to-experiment" method="POST" class="wibes-add-form">
                <input type="hidden" name="reagent_id" value="{{ .ID }}">
                <input type="hidden" name="quantity" value="1">
                <button type="submit" class="wibes-add-btn">В корзину →</button>
            </form>
        </div>
    </div>
</main>
</body>
</html>