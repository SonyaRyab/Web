<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Реагенты - Синтез метана</title>
    <link rel="stylesheet" href="/styles/index_style.css">
</head>
<body>
<header class="full-width-header">
    <div class="header-title">Калькулятор синтеза метана (Реакция Сабатье)</div>
</header>

<div class="tools-panel">
    <div class="search-container">
        <form action="/reagents" method="GET" class="search-form">
            <input
                type="text"
                name="search"
                placeholder="Поиск по названию..."
                value="{{ .search }}"
                class="search-input"
            >
            <button type="submit" class="search-button">Найти</button>
            {{ if .search }}
            <a href="/reagents" class="clear-search"></a>
            {{ end }}
        </form>
    </div>
    <div class="cart-link">
        {{ if gt .cart_count 0 }}
        <a href="/methane" class="calculate-btn cart-active" onclick="console.log('Cart clicked!');">
            <span class="cart-badge">{{ .cart_count }}</span>
            <svg class="cart-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
            </svg>
        </a>
        {{ else }}
        <span class="calculate-btn cart-disabled">
            <svg class="cart-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z"/>
            </svg>
        </span>
        {{ end }}
    </div>
</div>

<div class="product-section">
    {{ range .data }}
    <div class="product-card" onclick="window.location.href='/reagents/{{ .ID }}'" style="cursor: pointer;">
        <div class="product-title-container">
            <div class="product-name">{{ .Name }}</div>
        </div>

        <div class="product-container">
            <div class="product-formula">{{ .Formula }}</div>
            <h1>
                <img src="{{ .Img }}" alt="{{ .Name }}" width="150px" height="150px">
            </h1>
            <form action="/add-to-methane" method="POST" style="display: inline;">
                <input type="hidden" name="reagent_id" value="{{ .ID }}">
                <input type="hidden" name="quantity" value="1">
            </form>
        </div>
    </div>
    {{ end }}
</div>
</body>
</html>